# Copiá este archivo como .env.local para desarrollo.
# TODAS estas variables tienen que estar cargadas tambien en Vercel
# (Settings > Environment Variables > entorno Production) y despues hay que
# volver a desplegar: las NEXT_PUBLIC_* se inyectan en tiempo de build.

# Redsys
REDSYS_SECRET_KEY=
REDSYS_FUC=
REDSYS_TERMINAL=
REDSYS_ENVIRONMENT=

# URL publica del sitio
NEXT_PUBLIC_BASE_URL=

# Resend (formulario de contacto)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudinary (imagenes de los recursos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase / Firestore (datos de los recursos)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
